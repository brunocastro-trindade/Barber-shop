# Copie este arquivo para .env.local e preencha os valores.
# .env.local está no .gitignore e nunca deve ser comitado.

# Connection string do Neon (Dashboard → seu projeto → Connect).
# Use a opção "Pooled connection" e mantenha o sslmode=require.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Chave que assina os cookies de sessão. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Trocar esta chave desconecta todo mundo. Mínimo de 32 caracteres.
JWT_SECRET="troque-por-uma-chave-longa-e-aleatoria-de-no-minimo-32-caracteres"

# Porta da API local (o Vite faz proxy de /api para cá).
PORT=3001

# Cria clientes, visitas e agendamentos de exemplo junto com cada conta nova,
# para o painel não abrir vazio. Use false para contas limpas.
SEED_DEMO_DATA=true
